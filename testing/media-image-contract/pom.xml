<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkword.testing</groupId>
    <artifactId>quarkword-testing-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkword-test-media-image-contract</artifactId>

  <name>QuarkWord :: testing :: media image contract</name>
  <description>The tests every QuarkWord image processor runs: what the media image SPI asks of an implementation, whatever library does the work. Test scope only.</description>

  <properties>
    <automatic.module.name>org.quarkword.testing.mediaimage</automatic.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-media</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword.testing</groupId>
      <artifactId>quarkword-test-wp-rest-parity</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword.testing</groupId>
      <artifactId>quarkword-test-gen</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.drewnoakes</groupId>
      <artifactId>metadata-extractor</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
