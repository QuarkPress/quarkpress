<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkpress.testing</groupId>
    <artifactId>quarkpress-testing-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkpress-test-wp-rest-parity</artifactId>

  <name>QuarkPress :: testing :: WordPress REST parity</name>
  <description>Serves the WordPress 7.1.3 scenario network over HTTP with php -S, so REST requests can be compared with QuarkPress's. Test scope only.</description>

  <properties>
    <automatic.module.name>org.quarkpress.testing.wprestparity</automatic.module.name>
    <!-- Kept in line with testing/wp-scenario, whose QuarkPress side builds on Quarkus 3.40 and JUnit 6. -->
    <junit.version>6.1.3</junit.version>
    <!-- Quarkus adds its own JVM flags to @{argLine}; empty when nothing sets it. -->
    <argLine></argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.quarkpress.testing</groupId>
      <artifactId>quarkpress-test-wp-scenario</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress.testing</groupId>
      <artifactId>quarkpress-test-wp-oracle</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress.testing</groupId>
      <artifactId>quarkpress-test-gen</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Testcontainers logs through SLF4J; without a provider every test run warns. The version follows the
         slf4j-api the Quarkus BOM manages. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.18</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- spotless:apply and spotless:check also cover the capture source (profile capture-har) whenever they run. -->
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
              <include>src/capture/java/**/*.java</include>
            </includes>
          </java>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} ${surefire.argLine.additional}</argLine>
          <systemPropertyVariables>
            <maven.home>${maven.home}</maven.home>
          </systemPropertyVariables>
          <!-- The test database of the QuarkPress side reaches the test application as an environment variable: a
               quarkpress.* system property would be rejected by the QuarkPress configuration root. -->
          <environmentVariables>
            <QUARKPRESS_TEST_DB>${testDb}</QUARKPRESS_TEST_DB>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Manual only, never in CI: records the block editor's network traffic against the live WordPress site as HAR
           files in target/har (src/capture/java). Run together with wp-parity; downloads Playwright's browsers on
           first use. Without this profile neither Playwright nor the capture source is on any path. -->
      <id>capture-har</id>
      <properties>
        <har.dir>${project.build.directory}/har</har.dir>
      </properties>
      <dependencies>
        <dependency>
          <groupId>com.microsoft.playwright</groupId>
          <artifactId>playwright</artifactId>
          <version>1.63.0</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-capture-source</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/capture/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/EditorHarCapture.java</include>
              </includes>
              <systemPropertyVariables>
                <har.dir>${har.dir}</har.dir>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
