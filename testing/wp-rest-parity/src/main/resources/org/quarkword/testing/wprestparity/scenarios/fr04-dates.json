{
  "id": "fr04",
  "front": true,
  "rule": "front end, date archives under the default structure (FR G19; FQ G-3, G-4): an impossible day or month is redirected to the archive above it, a one-digit day is served as it is, query-string dates and m values are redirected to their archives or not found",
  "setup": [
    {
      "option": "permalink_structure",
      "value": "/%year%/%monthnum%/%day%/%postname%/"
    },
    {
      "post": "p:winter",
      "as": "alice",
      "type": "post",
      "status": "publish",
      "title": "Winter",
      "fields": {
        "slug": "winter",
        "date_gmt": "2025-01-05T08:00:00"
      }
    },
    {
      "post": "p:valentine",
      "as": "alice",
      "type": "post",
      "status": "publish",
      "title": "Valentine",
      "fields": {
        "slug": "valentine",
