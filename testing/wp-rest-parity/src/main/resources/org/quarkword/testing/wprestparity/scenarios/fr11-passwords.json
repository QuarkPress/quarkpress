{
  "id": "fr11",
  "front": true,
  "rule": "front end, password-protected posts (FQ G-19, G-20; FQ24-FQ26): the form page, POST wp-login.php ?action=postpass with a same-site target, no target, another host's target and a Referer (302 or 200 with the post-password cookie, compared by name), the action read by GET, the post with the right and a wrong cookie; the cookie values are portable phpass hashes of s3 and of wrong (php-verified), named by md5('http://localhost/'), the network's siteurl",
  "setup": [
    {
      "option": "permalink_structure",
      "value": "/%year%/%monthnum%/%day%/%postname%/"
    },
    {
      "post": "p:locked",
      "as": "alice",
      "type": "post",
      "status": "publish",
      "title": "Locked",
      "fields": {
        "slug": "locked",
        "date_gmt": "2025-11-19T08:00:00",
        "password": "s3"
      }
    },
    {
      "post": "p:hello",
      "as": "alice",
      "type": "post",
      "status": "publish",
      "title": "Hello world",
      "fields": {
        "slug": "hello-world",
        "date_gmt": "2025-11-20T10:15:30"
      }
    }
  ],
  "requests": [
    {
      "as": "anonymous",
      "method": "GET",
      "target": "/2025/11/19/locked/"
    },
    {
      "as": "anonymous",
      "method": "POST",
      "target": "/wp-login.php?action=postpass",
      "contentType": "application/x-www-form-urlencoded",
      "body": "post_password=s3&redirect_to=http%3A%2F%2Flocalhost%2Ffr11%2F2025%2F11%2F19%2Flocked%2F"
    },
    {
      "as": "anonymous",
      "method": "POST",
      "target": "/wp-login.php?action=postpass",
      "contentType": "application/x-www-form-urlencoded",
      "body": "post_password=s3"
    },
    {
      "as": "anonymous",
      "method": "POST",
      "target": "/wp-login.php?action=postpass",
      "contentType": "application/x-www-form-urlencoded",
      "body": "post_password=s3&redirect_to=https%3A%2F%2Fevil.test%2F"
    },
    {
      "as": "anonymous",
      "method": "POST",
      "target": "/wp-login.php?action=postpass",
      "headers": {
        "Referer": "http://localhost/fr11/2025/11/19/locked/"
      },
      "contentType": "application/x-www-form-urlencoded",
      "body": "post_password=s3"
    },
    {
      "as": "anonymous",
      "method": "GET",
      "target": "/wp-login.php?action=postpass"
    },
    {
      "as": "anonymous",
      "method": "GET",
      "target": "/2025/11/19/locked/",
      "headers": {
        "Cookie": "wp-postpass_c9db569cb388e160e4b86ca1ddff84d7=%24P%24Bvd3lOTWuG7hIQ9c8Ek1xXxsPAaSr.%2F"
      }
    },
    {
      "as": "anonymous",
      "method": "GET",
      "target": "/2025/11/19/locked/?p={p:locked}",
      "headers": {
        "Cookie": "wp-postpass_c9db569cb388e160e4b86ca1ddff84d7=%24P%24Bvd3lOTWuG7hIQ9c8Ek1xXxsPAaSr.%2F"
      }
    },
    {
      "as": "anonymous",
      "method": "GET",
      "target": "/2025/11/19/locked/",
      "headers": {
        "Cookie": "wp-postpass_c9db569cb388e160e4b86ca1ddff84d7=%24P%24BNpLm2GBd9YFvVOESLMfn0gkM%2FM35h1",
        "Referer": "http://localhost/fr11/2025/11/19/locked/"
      }
    },
    {
      "as": "anonymous",
      "method": "GET",
      "target": "/wp-login.php"
    }
  ]
}
