{
  "id": "d02",
  "rule": "Part D 2: a non-string rest_route is refused before the REST server, as HTML or as JSON when the request accepts JSON",
  "setup": [],
  "requests": [
    {
      "as": "anonymous",
      "method": "GET",
      "target": "/?rest_route[]=x"
    },
    {
      "as": "anonymous",
      "method": "GET",
      "target": "/wp-json/wp/v2?rest_route[]=x"
    },
    {
      "as": "anonymous",
      "method": "GET",
      "target": "/?rest_route[]=x",
      "headers": {
        "Accept": "application/json"
      }
    }
  ]
}
