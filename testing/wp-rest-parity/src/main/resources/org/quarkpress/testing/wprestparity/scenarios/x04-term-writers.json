{
  "id": "x04",
  "rule": "who writes terms: creating, changing and deleting categories and tags per role (refusals 401 or 403 rest_cannot_create, rest_cannot_update, rest_cannot_delete); users in the edit context per role",
  "setup": [
    {
      "term": "t:cat",
      "as": "alice",
      "taxonomy": "category",
      "name": "x04-cat"
    },
    {
      "term": "t:tag",
      "as": "alice",
      "taxonomy": "post_tag",
      "name": "x04-tag"
    },
    {
      "term": "t:cat-del",
      "as": "alice",
      "taxonomy": "category",
      "name": "x04-cat-del"
    },
    {
      "term": "t:tag-del",
      "as": "alice",
      "taxonomy": "post_tag",
      "name": "x04-tag-del"
    }
  ],
  "requests": [
