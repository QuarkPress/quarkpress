{
  "id": "p08",
  "rule": "updating posts and pages (POST/PUT/PATCH /wp/v2/<base>/<id>): WordPress's update checks in its order (lookup, edit_post, another author, a sticky change, terms) per caller, the answer in the edit context, the editor's first save of an auto-draft (empty_content, then the draft with the default category and format), the revision after the update and none for an update without fields, the trash refused as a status, format, sticky, featured media, template and terms, the slugs of child pages (published by the stored parent, drafts by the request's), and the date rules (an offset, the same date again, null dates, a date ahead and publish)",
  "setup": [
    {
      "option": "default_post_format",
      "value": "aside"
    },
    {
      "draft": "p:new",
      "as": "carol",
      "type": "post"
    },
    {
      "option": "default_post_format",
      "value": "0"
    },
    {
      "post": "p:carols",
      "as": "carol",
      "type": "post",
      "status": "draft",
      "title": "p08 carol draft"
    },
    {
      "post": "p:published",
      "as": "alice",
      "type": "post",
      "status": "publish",
      "title": "p08 published",
      "fields": {
        "content": "p08 first"
      }
    },
    {
      "post": "p:dates",
      "as": "alice",
      "type": "post",
      "status": "publish",
      "title": "p08 dates",
      "fields": {
        "date_gmt": "2026-09-01T10:00:00"
      }
    },
    {
      "post": "p:dated",
      "as": "alice",
      "type": "post",
      "status": "draft",
      "title": "p08 dated"
    },
    {
      "post": "p:back",
      "as": "alice",
      "type": "post",
      "status": "publish",
      "title": "p08 back to draft",
      "fields": {
        "date_gmt": "2026-09-01T10:00:00"
      }
    },
    {
      "post": "p:parent",
      "as": "alice",
      "type": "page",
      "status": "publish",
      "title": "p08 parent",
      "fields": {
        "slug": "p08-parent"
      }
    },
    {
      "post": "p:childa",
      "as": "alice",
      "type": "page",
      "status": "publish",
      "title": "p08 child a",
      "fields": {
        "slug": "p08-child-a",
        "parent": "p:parent"
      }
    },
    {
      "post": "p:childb",
      "as": "alice",
      "type": "page",
      "status": "publish",
      "title": "p08 child b",
      "fields": {
        "slug": "p08-child-b",
        "parent": "p:parent"
      }
    },
    {
      "post": "p:top",
      "as": "alice",
      "type": "page",
      "status": "publish",
      "title": "p08 top",
      "fields": {
        "slug": "p08-top"
      }
    },
    {
      "term": "t:tag",
      "as": "alice",
      "taxonomy": "post_tag",
      "name": "p08-tag"
    }
  ],
  "requests": [
