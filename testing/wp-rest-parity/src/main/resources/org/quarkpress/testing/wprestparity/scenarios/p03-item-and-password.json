{
  "id": "p03",
  "rule": "a single post, password protection and the order of the item checks: every caller reads a published post with a password without, with the right, with a wrong and with an empty password, in the edit context and with a wrong password there, a wrong password on a post without one, a draft and another author's private post in both contexts; then the missing id, another type's id, the collection's password lift that never refuses, HEAD and the embed context",
  "setup": [
    {
      "post": "p:secret",
      "as": "carol",
      "type": "post",
      "status": "publish",
      "title": "p03 secret",
      "fields": {
        "content": "p03 secret content",
        "excerpt": "p03 secret excerpt",
        "password": "s3"
      }
    },
    {
      "post": "p:open",
      "as": "carol",
      "type": "post",
      "status": "publish",
      "title": "p03 open",
      "fields": {
        "content": "p03 open content"
      }
    },
    {
      "post": "p:draft",
      "as": "carol",
      "type": "post",
      "status": "draft",
      "title": "p03 draft"
    },
    {
      "post": "p:private",
      "as": "bob",
      "type": "post",
      "status": "private",
      "title": "p03 private"
    },
    {
      "post": "p:page",
      "as": "bob",
      "type": "page",
      "status": "publish",
      "title": "p03 page"
    }
