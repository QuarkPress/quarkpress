{
  "id": "p07",
  "rule": "creating posts, pages and books (POST /wp/v2/<base>): WordPress's create checks in its order (an existing id, another author, sticky on any type, create_posts) per caller, its preparation errors (status, author, password with sticky, parent, empty post, template, impossible dates) and outcomes (dates with and without offsets, slugs of drafts made unique as published, sticky, featured media, formats, terms, filtered and escaped text, block delimiters written again), answered 201 in the edit context",
  "setup": [
    {
      "post": "p:taken",
      "as": "alice",
      "type": "post",
      "status": "publish",
      "title": "p07 taken",
      "fields": {
        "slug": "p07-taken"
      }
    },
    {
      "post": "p:parent",
      "as": "alice",
      "type": "page",
      "status": "publish",
      "title": "p07 parent",
      "fields": {
        "slug": "p07-parent"
      }
    },
