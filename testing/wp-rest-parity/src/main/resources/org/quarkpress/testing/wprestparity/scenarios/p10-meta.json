      "target": "/wp-json/wp/v2/posts/{p:daves}?_fields=id,meta",
      "contentType": "application/json",
      "body": "{\"meta\":{\"footnotes\":\"{\\\"x\\\":{\\\"id\\\":\\\"a\\\",\\\"content\\\":\\\"b\\\"}}\"}}"
    },
