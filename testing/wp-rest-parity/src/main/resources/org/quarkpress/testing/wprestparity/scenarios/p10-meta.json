{
  "id": "p10",
  "rule": "the meta field on writes (PUT/POST /wp/v2/<base>[/<id>] with meta): a registered key that does not fit its schema (the meta.<name> error with its param in additional_data), unknown keys ignored, a meta that is not an object or a list refused, null as absent, the footnotes sanitizer per caller (unfiltered_html or not; not JSON, a JSON object, which is a PHP array too, a number), null deleting, a list key replaced, emptied and given as text, a numeric text coerced, the errors of several keys in one answer, permissions per caller, a create with meta, the revision copying the footnotes of the same request and none after a failed meta step; what WordPress keeps of a write whose meta fails (the post, its title, the keys before the failure) differs (D29)",
  "setup": [
    {
      "post": "p:carols",
      "as": "carol",
      "type": "post",
      "status": "draft",
      "title": "p10 carol draft"
    },
    {
      "post": "p:daves",
      "as": "dave",
      "type": "post",
      "status": "draft",
      "title": "p10 dave draft"
    },
    {
      "post": "p:alices",
      "as": "alice",
      "type": "post",
      "status": "draft",
      "title": "p10 alice draft"
    },
    {
      "post": "p:book",
      "as": "carol",
      "type": "book",
      "status": "draft",
      "title": "p10 carol book"
    },
    {
      "post": "p:pub",
      "as": "alice",
      "type": "post",
      "status": "publish",
      "title": "p10 published",
      "fields": {
        "content": "p10 first"
      }
    },
    {
      "revision": "r:pub",
      "as": "alice",
      "post": "p:pub",
      "title": "p10 published",
      "content": "p10 second"
    }
  ],
  "requests": [
    {
      "as": "carol",
      "method": "PUT",
      "target": "/wp-json/wp/v2/posts/{p:carols}?_fields=id,meta",
      "contentType": "application/json",
      "body": "{\"meta\":{\"footnotes\":5}}"
    },
    {
      "as": "carol",
      "method": "PUT",
      "target": "/wp-json/wp/v2/posts/{p:carols}?_fields=id,meta,featured_media",
      "contentType": "application/json",
      "body": "{\"meta\":{\"qp_unknown\":\"x\",\"_thumbnail_id\":\"7\"}}"
    },
    {
      "as": "carol",
      "method": "PUT",
      "target": "/wp-json/wp/v2/posts/{p:carols}?_fields=id,meta",
      "contentType": "application/json",
      "body": "{\"meta\":\"x\"}"
    },
    {
      "as": "carol",
      "method": "PUT",
      "target": "/wp-json/wp/v2/posts/{p:carols}?_fields=id,meta",
      "contentType": "application/json",
      "body": "{\"meta\":null}"
    },
    {
      "as": "carol",
      "method": "PUT",
      "target": "/wp-json/wp/v2/posts/{p:carols}?_fields=id,meta",
      "contentType": "application/json",
      "body": "{\"meta\":[\"x\"]}"
    },
    {
      "as": "alice",
      "method": "PUT",
      "target": "/wp-json/wp/v2/posts/{p:alices}?_fields=id,meta",
      "contentType": "application/json",
      "body": "{\"meta\":{\"footnotes\":\"[{\\\"id\\\":\\\"a\\\",\\\"content\\\":\\\"<script>x</script>/y\\\"}]\"}}"
    },
    {
      "as": "dave",
      "method": "PUT",
      "target": "/wp-json/wp/v2/posts/{p:daves}?_fields=id,meta",
      "contentType": "application/json",
      "body": "{\"meta\":{\"footnotes\":\"[{\\\"id\\\":\\\"a\\\",\\\"content\\\":\\\"<script>x</script>/y\\\"}]\"}}"
    },
