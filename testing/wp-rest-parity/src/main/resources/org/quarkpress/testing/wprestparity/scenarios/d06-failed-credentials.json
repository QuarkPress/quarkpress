{
  "id": "d06",
  "rule": "Part D 6: a credential the server refuses (QuarkPress: 401 rest_invalid_token before matching, README D2; WordPress answers as anonymous); an unknown Basic user; a valid caller",
  "setup": [],
  "requests": [
    {
      "as": "invalid",
      "method": "GET",
      "target": "/wp-json/wp/v2/users/me"
    },
    {
