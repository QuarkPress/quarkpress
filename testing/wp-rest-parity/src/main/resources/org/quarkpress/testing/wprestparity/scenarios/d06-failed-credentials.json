      "method": "GET",
      "target": "/wp-json/wp/v2/types"
    },
    {
      "as": "invalid",
      "method": "GET",
      "target": "/wp-json/qp/none"
    },
    {
      "as": "anonymous",
      "method": "GET",
      "target": "/wp-json/wp/v2/users/me",
      "headers": {
        "Authorization": "Basic bm9ib2R5Om5vdC1hLXBhc3N3b3Jk"
      }
    },
    {
      "as": "erin",
      "method": "GET",
      "target": "/wp-json/wp/v2/users/me"
    }
  ]
}
