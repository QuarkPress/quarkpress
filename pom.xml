<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.quarkpress</groupId>
  <artifactId>quarkpress-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>QuarkPress Parent</name>
  <description>WordPress business features for the Java/Quarkus ecosystem</description>
  <url>https://quarkpress.org</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>bom</module>
    <!-- test-only support; listed before libs because the libs use it at test scope -->
    <module>testing</module>
    <module>libs</module>
    <module>extensions</module>
    <module>integration-tests</module>
  </modules>

  <scm>
    <connection>scm:git:https://github.com/QuarkPress/quarkpress.git</connection>
    <developerConnection>scm:git:git@github.com:QuarkPress/quarkpress.git</developerConnection>
    <url>https://github.com/QuarkPress/quarkpress</url>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Platform. Quarkus 3.40 is the current LTS (released 2026-09-30). -->
    <quarkus.platform.version>3.40.1</quarkus.platform.version>
    <!-- Kept equal to the version managed by the Quarkus BOM above; libs do not import that BOM. -->
    <jackson.version>2.21.7</jackson.version>

    <!-- Test libraries -->
    <junit.version>5.14.4</junit.version>
    <assertj.version>3.27.7</assertj.version>

    <!-- Plugins -->
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <spotless.version>3.10.4</spotless.version>
    <palantir-java-format.version>2.102.0</palantir-java-format.version>

    <!-- Extra JVM flags for test forks. They are here because the maintainers' build host faults
         under heavy multi-threaded JIT load (C1 only, 8 visible processors); they are not needed
         for correctness. Override with -Dsurefire.argLine.additional=... -->
    <surefire.argLine.additional>-XX:TieredStopAtLevel=1 -XX:ActiveProcessorCount=8</surefire.argLine.additional>
    <!-- Database used by container-backed tests: postgresql or mysql. CI runs both. -->
    <testDb>postgresql</testDb>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <parameters>true</parameters>
            <compilerArgs>
              <arg>-Xlint:all,-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <argLine>${surefire.argLine.additional}</argLine>
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
          <configuration>
            <archive>
              <manifestEntries>
                <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <palantirJavaFormat>
                <version>${palantir-java-format.version}</version>
              </palantirJavaFormat>
              <removeUnusedImports/>
            </java>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Compares the standalone libraries with real WordPress PHP code (testing/wp-oracle): downloads pinned
           WordPress files into target/wp-source and runs php 8.4. Needs network and php; without them the
           parity tests fail rather than skip. Override with -Dwp.php=/path/to/php or -Dwp.version=... -->
      <id>wp-parity</id>
      <properties>
        <wp.version>7.1.3</wp.version>
        <wp.php>php</wp.php>
      </properties>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <systemPropertyVariables>
                  <wp.version>${wp.version}</wp.version>
                  <wp.php>${wp.php}</wp.php>
                  <quarkpressRoot>${maven.multiModuleProjectDirectory}</quarkpressRoot>
                </systemPropertyVariables>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
    <profile>
      <!-- Native executables are built and tested only in GitHub Actions. -Dnative, -Dquarkus.native.enabled=true
           and -Dquarkus.package.type=native fail at validate unless the CI environment variable is "true". -->
      <id>native</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>native-only-in-ci</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireEnvironmentVariable>
                      <variableName>CI</variableName>
                      <regex>true</regex>
                      <message>Native builds run only in GitHub Actions (CI=true). Run the JVM tests locally.</message>
                      <regexMessage>Native builds run only in GitHub Actions (CI=true). Run the JVM tests locally.</regexMessage>
                    </requireEnvironmentVariable>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native-enabled-guard</id>
      <activation>
        <property>
          <name>quarkus.native.enabled</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>native-only-in-ci</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireEnvironmentVariable>
                      <variableName>CI</variableName>
                      <regex>true</regex>
                      <message>Native builds run only in GitHub Actions (CI=true). Run the JVM tests locally.</message>
                      <regexMessage>Native builds run only in GitHub Actions (CI=true). Run the JVM tests locally.</regexMessage>
                    </requireEnvironmentVariable>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native-package-guard</id>
      <activation>
        <property>
          <name>quarkus.package.type</name>
          <value>native</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>native-only-in-ci</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireEnvironmentVariable>
                      <variableName>CI</variableName>
                      <regex>true</regex>
                      <message>Native builds run only in GitHub Actions (CI=true). Run the JVM tests locally.</message>
                      <regexMessage>Native builds run only in GitHub Actions (CI=true). Run the JVM tests locally.</regexMessage>
                    </requireEnvironmentVariable>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
