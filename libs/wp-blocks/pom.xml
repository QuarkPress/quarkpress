<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkpress.lib</groupId>
    <artifactId>quarkpress-libs-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkpress-lib-wp-blocks</artifactId>

  <name>QuarkPress :: lib :: WP blocks</name>
  <description>Parse and serialize Gutenberg block markup with byte-identical round trips</description>

  <properties>
    <automatic.module.name>org.quarkpress.lib.wpblocks</automatic.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <!-- Runs the Gutenberg parser fixtures. Needs network and git on first run; cached in target/. -->
      <id>conformance</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <gutenberg.fixtures.dir>${project.build.directory}/gutenberg-fixtures</gutenberg.fixtures.dir>
                <gutenberg.fixtures.commit>954fe7f9e04631c41aec4552acd627a7203a2aad</gutenberg.fixtures.commit>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
