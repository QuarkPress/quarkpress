<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkword</groupId>
    <artifactId>quarkword-rest-wp-v2-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkword-rest-wp-v2-deployment</artifactId>

  <name>QuarkWord :: REST API (WordPress v2) :: Deployment</name>

  <properties>
    <automatic.module.name>org.quarkword.restwp.deployment</automatic.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-rest-wp-v2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-core-deployment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-persistence-deployment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-security-deployment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-posts-deployment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-taxonomy-deployment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-blocks-deployment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-outbound-deployment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-revisions-deployment</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-scheduling-deployment</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-multisite-deployment</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-media-deployment</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson-deployment</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-cache-deployment</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-cache-deployment-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-internal</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql-deployment</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-mysql-deployment</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.quarkword.testing</groupId>
      <artifactId>quarkword-test-gen</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- the test applications store uploads on the filesystem and make image sizes with ImageIO -->
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-media-storage-fs-deployment</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-media-image-imageio-deployment</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- the media fixtures only (JDK-only code): the module's scenario dependencies would add extensions to the test apps -->
    <dependency>
      <groupId>org.quarkword.testing</groupId>
      <artifactId>quarkword-test-wp-rest-parity</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Every test class builds its own application, and on JDK 21 one reused test JVM ran out of code cache over
           the module's classes: a fresh JVM per test class keeps one class's applications from filling it for the
           next. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <reuseForks>false</reuseForks>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
