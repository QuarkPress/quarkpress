<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkword</groupId>
    <artifactId>quarkword-extensions-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkword-media-image-vips-parent</artifactId>
  <packaging>pom</packaging>

  <name>QuarkWord :: Media Image Vips :: Parent</name>

  <!-- quarkus-libvips calls libvips through the Foreign Function and Memory API as Java 25 has it, so this module
       is built for and on Java 25 only. The extensions POM lists it in the jdk25-modules profile, which a Java 21
       build never activates. -->
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <modules>
    <module>runtime</module>
    <module>deployment</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- The root flags, plus native access for quarkus-libvips's downcalls. -->
            <argLine>${surefire.argLine.additional} --enable-native-access=ALL-UNNAMED</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
