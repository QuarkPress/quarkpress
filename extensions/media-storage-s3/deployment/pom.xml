<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkpress</groupId>
    <artifactId>quarkpress-media-storage-s3-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkpress-media-storage-s3-deployment</artifactId>

  <name>QuarkPress :: Media Storage S3 :: Deployment</name>

  <properties>
    <automatic.module.name>org.quarkpress.media.storage.s3.deployment</automatic.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-media-storage-s3</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-media-deployment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkiverse.amazonservices</groupId>
      <artifactId>quarkus-amazon-s3-deployment</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-internal</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql-deployment</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-mysql-deployment</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The filesystem backend next to this one, for the tests that choose between them. -->
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-media-storage-fs-deployment</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The storage contract every backend passes. -->
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-media</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The AWS SDK reads the shared profile files (~/.aws/config, ~/.aws/credentials) even when Dev Services
               hand it static credentials, and fails on a file it cannot parse. The tests and the application they
               start (it inherits the environment) use files that do not exist, so the host's AWS setup never
               matters. -->
          <environmentVariables>
            <AWS_CONFIG_FILE>${project.build.directory}/no-aws-config</AWS_CONFIG_FILE>
            <AWS_SHARED_CREDENTIALS_FILE>${project.build.directory}/no-aws-credentials</AWS_SHARED_CREDENTIALS_FILE>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
