<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkword</groupId>
    <artifactId>quarkword-integration-tests-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkword-it-keycloak</artifactId>

  <name>QuarkWord :: Integration tests :: Keycloak</name>
  <description>A single site with the REST API (wp/v2) and the Keycloak provisioner: users imported with their WordPress password hashes sign in through Keycloak, which has the quarkword-keycloak hash provider, and their passwords move to Argon2. JVM mode locally, also native in CI.</description>

  <properties>
    <automatic.module.name>org.quarkword.it.keycloak</automatic.module.name>
    <!-- The quarkword-keycloak checkout (the root POM pins its commit as quarkword-keycloak.commit): its packaged
         provider jar is mounted into Dev Services' Keycloak and its WordPress-made hashes are the test's fixtures.
         Locally a checkout beside this repository; CI passes -DquarkwordKeycloakDir. Without the jar or the fixtures, or
         with a jar older than the checkout's sources, the end-to-end tests are skipped; -DrequireKeycloakProvider=true
         (CI) makes them fail instead. A checkout at another commit than the pin is logged as a warning. The names
         carry no quarkword. prefix: Surefire hands -D properties to the test JVM, whose QuarkWord configuration
         root refuses undeclared quarkword.* settings. -->
    <quarkwordKeycloakDir>${maven.multiModuleProjectDirectory}/../quarkword-keycloak</quarkwordKeycloakDir>
    <keycloakProviderJar>${quarkwordKeycloakDir}/wp-password/target/quarkword-keycloak-wp-password.jar</keycloakProviderJar>
    <keycloakHashes>${quarkwordKeycloakDir}/wp-password/src/test/resources/wordpress-7.1.3-hashes.txt</keycloakHashes>
    <requireKeycloakProvider>false</requireKeycloakProvider>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-rest-wp-v2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-keycloak-provisioner</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-keycloak-server</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Make the reactor build the deployment modules before this application. -->
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-core-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-persistence-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-security-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-posts-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-taxonomy-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-rest-wp-v2-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkword</groupId>
      <artifactId>quarkword-keycloak-provisioner-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <keycloakProviderJar>${keycloakProviderJar}</keycloakProviderJar>
            <keycloakHashes>${keycloakHashes}</keycloakHashes>
            <requireKeycloakProvider>${requireKeycloakProvider}</requireKeycloakProvider>
            <quarkwordKeycloakDir>${quarkwordKeycloakDir}</quarkwordKeycloakDir>
            <quarkwordKeycloakCommit>${quarkword-keycloak.commit}</quarkwordKeycloakCommit>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <keycloakProviderJar>${keycloakProviderJar}</keycloakProviderJar>
            <keycloakHashes>${keycloakHashes}</keycloakHashes>
            <requireKeycloakProvider>${requireKeycloakProvider}</requireKeycloakProvider>
            <quarkwordKeycloakDir>${quarkwordKeycloakDir}</quarkwordKeycloakDir>
            <quarkwordKeycloakCommit>${quarkword-keycloak.commit}</quarkwordKeycloakCommit>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
