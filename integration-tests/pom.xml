<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkpress</groupId>
    <artifactId>quarkpress-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkpress-integration-tests-parent</artifactId>
  <packaging>pom</packaging>

  <name>QuarkPress :: Integration tests</name>
  <description>Applications that test the QuarkPress extensions end to end: JVM mode locally, also native in CI. Never published.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- Quarkus 3.40 builds on JUnit 6; the root POM imports junit-bom with this version. -->
    <junit.version>6.1.3</junit.version>
    <skipUnitTests>false</skipUnitTests>
    <!-- Quarkus adds its own JVM flags to @{argLine}; empty when nothing sets it. -->
    <argLine></argLine>
    <!-- JVM flags for the application that @QuarkusIntegrationTest starts (JVM mode only; empty for native). -->
    <it.app.argLine>${surefire.argLine.additional}</it.app.argLine>
  </properties>

  <modules>
    <module>tenancy-spike</module>
    <module>feature-extension</module>
    <module>content</module>
    <module>multisite</module>
    <module>security</module>
    <module>host-coexistence</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.platform.version}</version>
          <extensions>true</extensions>
          <executions>
            <execution>
              <goals>
                <goal>build</goal>
                <goal>generate-code</goal>
                <goal>generate-code-tests</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <skip>${skipUnitTests}</skip>
            <argLine>@{argLine} ${surefire.argLine.additional}</argLine>
            <systemPropertyVariables>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
              <maven.home>${maven.home}</maven.home>
            </systemPropertyVariables>
            <!-- The test database reaches tests and the application under test as an environment variable: a
                 quarkpress.* system property would be rejected by the QuarkPress configuration root. -->
            <environmentVariables>
              <QUARKPRESS_TEST_DB>${testDb}</QUARKPRESS_TEST_DB>
            </environmentVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <argLine>@{argLine} ${surefire.argLine.additional}</argLine>
            <systemPropertyVariables>
              <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
              <maven.home>${maven.home}</maven.home>
              <quarkus.test.arg-line>${it.app.argLine}</quarkus.test.arg-line>
            </systemPropertyVariables>
            <!-- The test database reaches tests and the application under test as an environment variable: a
                 quarkpress.* system property would be rejected by the QuarkPress configuration root. -->
            <environmentVariables>
              <QUARKPRESS_TEST_DB>${testDb}</QUARKPRESS_TEST_DB>
            </environmentVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <!-- Activated with -Dnative. The root POM's guard makes this fail unless CI=true. -->
      <id>native</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <properties>
        <quarkus.native.enabled>true</quarkus.native.enabled>
        <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
        <it.app.argLine></it.app.argLine>
      </properties>
    </profile>
  </profiles>
</project>
