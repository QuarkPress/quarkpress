<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkpress</groupId>
    <artifactId>quarkpress-integration-tests-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkpress-it-rest-wp-v2</artifactId>

  <name>QuarkPress :: Integration tests :: REST wp/v2</name>
  <description>A network application serving WordPress's REST API (wp/v2) with posts, categories and tags, revisions, scheduling, roles and capabilities, tested over HTTP with Keycloak tokens in JVM mode and as a native executable.</description>

  <properties>
    <automatic.module.name>org.quarkpress.it.restwp</automatic.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-rest-wp-v2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-multisite</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-posts</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-taxonomy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-revisions</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-scheduling</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-keycloak-server</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The REST parity comparison (RestParityDbTest, -Pwp-parity): WordPress served by php -S, the scenarios and
         the comparison library. -->
    <dependency>
      <groupId>org.quarkpress.testing</groupId>
      <artifactId>quarkpress-test-wp-rest-parity</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Make the reactor build the deployment modules before this application. -->
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-core-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-persistence-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-security-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-posts-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-taxonomy-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-revisions-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-scheduling-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-multisite-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-rest-wp-v2-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- RestParityDbTest sends its requests with java.net.http and names the site's host (localhost, without
                 the test port) in the Host header, as WordPress's side sees it. -->
            <jdk.httpclient.allowRestrictedHeaders>host</jdk.httpclient.allowRestrictedHeaders>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
