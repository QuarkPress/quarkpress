<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkpress</groupId>
    <artifactId>quarkpress-integration-tests-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkpress-it-dev-ui-posts</artifactId>
  <packaging>jar</packaging>

  <name>QuarkPress :: Integration tests :: Dev UI posts</name>
  <description>A dev-mode application with the core, persistence, multisite, security, posts and dev-ui modules but without taxonomy, revisions and scheduling, proving that the content methods load and answer without those modules. JVM dev mode only; never native.</description>

  <properties>
    <automatic.module.name>org.quarkpress.it.devui.posts</automatic.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-dev-ui</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-persistence</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-multisite</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-posts</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- dev-ui brings no HTTP server; the Dev UI needs one. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-vertx-http</artifactId>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-dev-ui-deployment</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-persistence-deployment</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-multisite-deployment</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-security-deployment</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-posts-deployment</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-vertx-http-deployment</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-internal</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-devui-test-spi</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql-deployment</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-mysql-deployment</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
